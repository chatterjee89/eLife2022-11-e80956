/*
 * Minimal test profile: tiny synthetic inputs wired to every param, meant to
 * be run with `-stub-run` to validate pipeline wiring/channel logic quickly
 * without real STAR/GENIE3/AUCell runtimes. Use with --mode full:
 *
 *   nextflow run main.nf -profile test -stub-run --mode full
 */
params {
    mode   = 'full'
    outdir = 'test_results'

    // bulk_de
    bulk_counts          = "${projectDir}/assets/test_data/bulk/featurecounts_test.csv"
    bulk_sample_info     = "${projectDir}/assets/test_data/bulk/sample_info_test.csv"
    bulk_contrast_column = 'PC1'
    bulk_contrast_levels = 'yes,no'
    deseq2_group_columns = 'group'

    // scrna_velocity
    scrna_ctrl_10x_dir     = "${projectDir}/assets/test_data/scrna/ctrl_10x"
    scrna_treatment_loom   = "${projectDir}/assets/test_data/scrna/treatment_test.loom"
    scrna_cell_cycle_genes = "${projectDir}/assets/test_data/scrna/cell_cycle_genes_test.txt"
    scrna_n_g2m_genes      = 3
    scrna_n_s_genes        = 3
    scrna_velocity_rds     = "${projectDir}/assets/test_data/scrna/velocity_test.rds"

    // scenic
    scenic_loom          = "${projectDir}/assets/test_data/scenic/scenic_test.loom"
    scenic_org            = 'mgi'
    scenic_cistarget_dir  = "${projectDir}/assets/test_data/scenic/cistarget_dummy"
    scenic_db_10kb        = 'dummy__10kb_up_and_down_tss.mc9nr.feather'
    scenic_db_500bp       = 'dummy__500bp_up_and_100bp_down_tss.mc9nr.feather'
    run_scenic_downstream = true
    // scenic_seurat_rds left null on purpose: in `full` mode it's wired
    // automatically from the scrna_velocity subworkflow's integrated object.
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '1 GB'
    time     = '10m'
}
