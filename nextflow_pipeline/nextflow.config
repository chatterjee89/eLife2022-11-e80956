manifest {
    name            = 'nf-multiomics-de-grn'
    description     = 'Bulk RNA-seq DE, scRNA-seq + RNA velocity, and R-SCENIC GRN inference as independent Nextflow subworkflows'
    author          = 'chatterjee89'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '0.1.0'
}

params {
    mode   = null   // 'bulk_de' | 'scrna_velocity' | 'scenic' | 'full'
    outdir = 'results'

    run_multiqc = true

    // ---------------------------------------------------------------
    // bulk_de
    // ---------------------------------------------------------------
    bulk_counts             = null   // featureCounts-style matrix CSV (Geneid rownames)
    bulk_sample_info        = null   // sample metadata CSV
    bulk_sample_id_col      = 'sample'
    bulk_contrast_column    = 'PC1'
    bulk_contrast_levels    = 'yes,no'   // numerator,denominator
    bulk_min_cpm            = 1.0
    bulk_min_samples        = 2
    bulk_lfc_threshold      = 1.2
    bulk_fdr                = 0.05

    skip_deseq2_diagnostics = false
    deseq2_group_columns    = 'group'
    deseq2_alpha            = 0.0001

    // ---------------------------------------------------------------
    // scrna_velocity (2-condition: control vs. treatment, by design)
    // ---------------------------------------------------------------
    scrna_ctrl_10x_dir            = null
    scrna_ctrl_sample_name        = 'Ctrl'
    scrna_treatment_loom          = null
    scrna_treatment_sample_name   = 'Treatment'

    scrna_cell_cycle_genes        = null   // newline gene list: first n_g2m_genes = G2M, next n_s_genes = S
    scrna_n_g2m_genes             = 68
    scrna_n_s_genes               = 56

    scrna_mito_pattern             = '^mt:'
    scrna_ribo_pattern             = '^Rp'

    scrna_ctrl_max_count           = 12000
    scrna_ctrl_max_feature         = 1800
    scrna_ctrl_min_feature         = 650
    scrna_ctrl_max_mito            = 10

    scrna_treat_max_count          = 15000
    scrna_treat_max_feature        = 1800
    scrna_treat_min_feature        = 600
    scrna_treat_max_mito           = 4.5

    scrna_npcs                     = 100
    scrna_dims                     = 60
    scrna_nfeatures                = 2000

    scrna_ctrl_resolution          = 1
    scrna_ctrl_umap_neighbors      = 40
    scrna_ctrl_umap_min_dist       = 0.25
    scrna_ctrl_drop_clusters       = ''

    scrna_treat_resolution         = 1
    scrna_treat_umap_neighbors     = 40
    scrna_treat_umap_min_dist      = 0.20
    scrna_treat_drop_clusters      = ''

    scrna_anchor_features          = 2000
    scrna_anchor_dims              = 50

    scrna_integration1_resolution     = 1.5
    scrna_integration1_umap_neighbors = 40
    scrna_integration1_umap_min_dist  = 0.20
    scrna_integration1_drop_clusters  = ''

    scrna_integration2_resolution     = 1
    scrna_integration2_umap_neighbors = 100
    scrna_integration2_umap_min_dist  = 0.50

    // Optional velocity leg (decoupled from integration above -- see
    // subworkflows/scrna_velocity.nf); leave null to skip it.
    scrna_velocity_rds             = null
    scrna_velocity_export_assays   = 'RNA,spliced,unspliced,ambiguous,integrated'

    scvelo_groupby                 = 'seurat_clusters'
    scvelo_min_r2                  = 1
    scvelo_min_corr_rank_genes     = 0.3
    scvelo_top_n_genes             = 15

    // ---------------------------------------------------------------
    // scenic
    // ---------------------------------------------------------------
    scenic_loom               = null   // expression matrix, genes x cells
    scenic_org                = 'mgi'  // SCENIC org code: mgi (mouse) / hgnc (human) / dmel (fly)
    scenic_cistarget_dir      = null
    scenic_db_10kb            = null
    scenic_db_500bp           = null
    scenic_dataset_title      = 'SCENIC run'
    scenic_min_counts_per_cell = 3
    scenic_min_pct_cells      = 0.01
    scenic_seed               = 123

    run_scenic_downstream     = false
    scenic_seurat_rds         = null   // required if run_scenic_downstream and mode != 'full'
    scenic_cell_type_column   = 'seurat_clusters'
    scenic_rss_threshold      = 0.4
    scenic_csi_nclust         = 10
}

profiles {
    conda {
        conda.enabled = true
    }

    local {
        process.executor = 'local'
    }

    sge {
        // Mirrors the original 02_SCENIC/01_run_SCENIC.sh SGE submission
        // (8 threads, 4G/slot) as a default; override per-process as needed.
        process.executor       = 'sge'
        process.clusterOptions = '-cwd'
        process.cpus           = 8
        process.memory         = '32 GB'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }
}

conda {
    enabled       = true
    useMamba      = true
    cacheDir      = "${launchDir}/.conda_envs"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
